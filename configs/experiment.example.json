{
  "purpose": "實驗紀錄範本；CLI 不自動載入此檔",
  "experiment": "causal_local_aux_batch_refresh_v4",
  "packet_timing": "synchronous_entire_batch_selected_before_any_acquisition",
  "target_scope": "one_target_per_sequence_reset_memory_between_sequences",
  "history": {
    "shared_gru": true,
    "observer_id_embedding": false,
    "include_historical_demand": false,
    "update_only_acquired_sources": true
  },
  "geometry": {
    "optional": true,
    "allowed_provenance": [
      "local_estimate",
      "history"
    ],
    "features": [
      "overlap_fraction",
      "target_coverage",
      "sin_relative_yaw",
      "cos_relative_yaw"
    ],
    "availability_masks": true
  },
  "training": {
    "cost": "actual_joint_subset_reconstruction_mpjpe",
    "loss": "sum(softmax(legal_subset_logits) * stop_gradient(joint_subset_costs))",
    "candidate_trials_start_from_identical_acquired_history": true,
    "selector_cannot_read_any_external_current_packets_before_selection": true,
    "training_action": "sample_entire_legal_subset_before_GT",
    "inference_action": "mandatory_refresh_plus_remaining_top_k",
    "gradient_scope": "conditional_one_step_not_long_horizon_policy_gradient",
    "pose_units": "metres",
    "pose_coordinate_frame": "root_relative"
  },
  "backend": {
    "name": "local-aux",
    "repository": "external/EgoExoMoCap",
    "checkpoint": "REQUIRES_TRAINED_LOCAL_AUX_V1_CHECKPOINT",
    "official_weight_transfer": "NOT_IMPLEMENTED",
    "body_model": "LICENSED_SMPL_H_REQUIRED_NOT_BUNDLED",
    "target_tracker_required": false,
    "camera_calibration_required": true,
    "output_axes": "last_requester_camera_opencv",
    "causal_last_frame_only": true,
    "warmup": "wait_for_full_past_window_no_future_padding"
  },
  "acquisition": {
    "max_sources": 2,
    "refresh_after_s": 1.0,
    "refresh_slots": 1,
    "max_exact_subsets": 4096,
    "note": "Engineering defaults, tune using validation only; no current external summary before batch selection"
  }
}
